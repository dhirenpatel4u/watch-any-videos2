/* =========================================================
   XPLAYER
   ========================================================= */

.xplayer {
  position: relative;

  width: 100%;

  /*
   * React sets this dynamically:
   *
   * 16:9  -> 16 / 9
   * 16:8  -> 16 / 8
   * 16:10 -> 16 / 10
   *
   * Anything taller than 16:10:
   *
   * 16:11 -> 16 / 10
   * 16:12 -> 16 / 10
   * 16:20 -> 16 / 10
   * 9:16  -> 16 / 10
   */
  aspect-ratio: var(--xplayer-ratio, 16 / 10);

  background: #000;

  overflow: hidden;

  border-radius: 12px;

  box-shadow:
    0 15px 50px
    rgba(0, 0, 0, 0.45);

  user-select: none;

  -webkit-user-select: none;

  touch-action: manipulation;
}


/* =========================================================
   VIDEO
   ========================================================= */

.xplayer-video {
  display: block;

  width: 100%;
  height: 100%;

  min-width: 0;
  min-height: 0;

  background: #000;

  /*
   * Keep the original video ratio.
   *
   * The player container controls the maximum
   * player area. Tall videos get contained
   * inside the 16:10 player.
   */
  object-fit: contain;

  object-position: center center;

  cursor: pointer;

  outline: none;

  border: 0;

  -webkit-tap-highlight-color: transparent;
}


/* =========================================================
   POSTER
   ========================================================= */

.xplayer-video::poster {
  object-fit: contain;
}


/* =========================================================
   CENTER PLAY BUTTON
   ========================================================= */

.xplayer-center-play {
  position: absolute;

  top: 50%;
  left: 50%;

  transform:
    translate(-50%, -50%);

  width: 74px;
  height: 74px;

  padding: 0;

  border: 0;

  border-radius: 50%;

  background:
    rgba(255, 45, 85, 0.96);

  color: #fff;

  display: flex;

  align-items: center;

  justify-content: center;

  cursor: pointer;

  z-index: 20;

  box-shadow:
    0 8px 30px
    rgba(0, 0, 0, 0.45);

  transition:
    transform 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease;

  -webkit-tap-highlight-color: transparent;
}

.xplayer-center-play:hover {
  transform:
    translate(-50%, -50%)
    scale(1.08);

  background: #ff2d55;

  box-shadow:
    0 10px 35px
    rgba(255, 45, 85, 0.3);
}

.xplayer-center-play:active {
  transform:
    translate(-50%, -50%)
    scale(0.96);
}

.xplayer-center-play:focus-visible {
  outline:
    2px solid #fff;

  outline-offset: 4px;
}


/* =========================================================
   LOADING
   ========================================================= */

.xplayer-loading {
  position: absolute;

  top: 50%;
  left: 50%;

  transform:
    translate(-50%, -50%);

  z-index: 30;

  pointer-events: none;
}

.xplayer-spinner {
  width: 44px;
  height: 44px;

  border:
    4px solid
    rgba(255, 255, 255, 0.2);

  border-top-color:
    #ff2d55;

  border-right-color:
    #ff2d55;

  border-radius: 50%;

  animation:
    xplayer-spin
    0.8s
    linear
    infinite;
}

@keyframes xplayer-spin {
  to {
    transform: rotate(360deg);
  }
}


/* =========================================================
   CONTROLS CONTAINER
   ========================================================= */

.xplayer-controls {
  position: absolute;

  left: 0;
  right: 0;
  bottom: 0;

  width: 100%;

  padding:
    28px 14px 10px;

  background:
    linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0),
      rgba(0, 0, 0, 0.45) 25%,
      rgba(0, 0, 0, 0.94) 100%
    );

  z-index: 15;

  transition:
    opacity 0.25s ease;

  box-sizing: border-box;
}

.xplayer-controls-visible {
  opacity: 1;

  pointer-events: auto;
}

.xplayer-controls-hidden {
  opacity: 0;

  pointer-events: none;
}


/* =========================================================
   PROGRESS BAR AREA
   ========================================================= */

.xplayer-progress-area {
  position: relative;

  width: 100%;

  height: 6px;

  margin-bottom: 9px;

  border-radius: 10px;

  background:
    rgba(255, 255, 255, 0.25);

  cursor: pointer;

  overflow: visible;

  transition:
    height 0.15s ease;
}

.xplayer-progress-area:hover {
  height: 8px;
}


/* =========================================================
   PROGRESS
   ========================================================= */

.xplayer-progress {
  position: relative;

  width: 0;

  height: 100%;

  border-radius: 10px;

  background:
    linear-gradient(
      90deg,
      #ff174f,
      #ff2d55
    );

  transition:
    width 0.05s linear;
}


/* =========================================================
   PROGRESS HANDLE
   ========================================================= */

.xplayer-progress::after {
  content: "";

  position: absolute;

  top: 50%;
  right: -6px;

  width: 13px;
  height: 13px;

  transform:
    translateY(-50%);

  border-radius: 50%;

  background: #fff;

  box-shadow:
    0 1px 5px
    rgba(0, 0, 0, 0.4);

  opacity: 0;

  transition:
    opacity 0.15s ease;
}

.xplayer-progress-area:hover
.xplayer-progress::after {
  opacity: 1;
}


/* =========================================================
   CONTROL ROW
   ========================================================= */

.xplayer-control-row {
  display: flex;

  align-items: center;

  width: 100%;

  min-width: 0;

  gap: 7px;

  box-sizing: border-box;
}


/* =========================================================
   GENERIC BUTTON
   ========================================================= */

.xplayer-btn {
  display: flex;

  align-items: center;

  justify-content: center;

  width: 36px;
  height: 36px;

  padding: 0;

  flex-shrink: 0;

  border: 0;

  border-radius: 6px;

  background:
    transparent;

  color: #fff;

  cursor: pointer;

  transition:
    background 0.15s ease,
    color 0.15s ease,
    transform 0.1s ease;

  -webkit-tap-highlight-color: transparent;
}

.xplayer-btn:hover {
  background:
    rgba(255, 255, 255, 0.13);
}

.xplayer-btn:active {
  transform:
    scale(0.92);
}

.xplayer-btn:focus-visible {
  outline:
    2px solid
    rgba(255, 255, 255, 0.8);

  outline-offset: 2px;
}


/* =========================================================
   TIME
   ========================================================= */

.xplayer-time {
  display: inline-block;

  color:
    rgba(255, 255, 255, 0.9);

  font-size: 13px;

  line-height: 1;

  white-space: nowrap;

  font-variant-numeric:
    tabular-nums;

  flex-shrink: 0;
}


/* =========================================================
   SPACER
   ========================================================= */

.xplayer-spacer {
  flex: 1 1 auto;

  min-width: 5px;
}


/* =========================================================
   VOLUME
   ========================================================= */

.xplayer-volume {
  display: flex;

  align-items: center;

  gap: 2px;

  flex-shrink: 0;
}


/* =========================================================
   VOLUME SLIDER
   ========================================================= */

.xplayer-volume-slider {
  width: 80px;

  height: 4px;

  margin: 0;

  padding: 0;

  cursor: pointer;

  accent-color: #ff2d55;

  flex-shrink: 0;
}


/* Chrome / Edge / Safari */

.xplayer-volume-slider::-webkit-slider-runnable-track {
  height: 4px;

  border-radius: 5px;

  background:
    rgba(255, 255, 255, 0.3);
}

.xplayer-volume-slider::-webkit-slider-thumb {
  appearance: none;

  -webkit-appearance: none;

  width: 12px;
  height: 12px;

  margin-top: -4px;

  border: 0;

  border-radius: 50%;

  background: #fff;

  cursor: pointer;
}


/* Firefox */

.xplayer-volume-slider::-moz-range-track {
  height: 4px;

  border-radius: 5px;

  background:
    rgba(255, 255, 255, 0.3);
}

.xplayer-volume-slider::-moz-range-thumb {
  width: 12px;
  height: 12px;

  border: 0;

  border-radius: 50%;

  background: #fff;

  cursor: pointer;
}


/* =========================================================
   SPEED WRAPPER
   ========================================================= */

.xplayer-speed-wrapper {
  position: relative;

  flex-shrink: 0;
}


/* =========================================================
   SPEED BUTTON
   ========================================================= */

.xplayer-speed-btn {
  min-width: 43px;

  padding:
    0 5px;

  font-size: 13px;

  font-weight: 600;
}


/* =========================================================
   SPEED MENU
   ========================================================= */

.xplayer-speed-menu {
  position: absolute;

  right: 0;

  bottom: 43px;

  min-width: 115px;

  max-height: 260px;

  padding: 6px;

  background:
    rgba(20, 22, 28, 0.98);

  border:
    1px solid
    rgba(255, 255, 255, 0.1);

  border-radius: 8px;

  box-shadow:
    0 12px 35px
    rgba(0, 0, 0, 0.55);

  z-index: 100;

  overflow-y: auto;

  box-sizing: border-box;
}


/* =========================================================
   SPEED OPTIONS
   ========================================================= */

.xplayer-speed-menu button {
  display: block;

  width: 100%;

  padding:
    9px 10px;

  border: 0;

  border-radius: 5px;

  background:
    transparent;

  color: #fff;

  text-align: left;

  font-size: 13px;

  line-height: 1.2;

  cursor: pointer;

  transition:
    background 0.15s ease,
    color 0.15s ease;
}

.xplayer-speed-menu button:hover {
  background:
    rgba(255, 255, 255, 0.1);
}

.xplayer-speed-menu button.active {
  color: #ff2d55;

  background:
    rgba(255, 45, 85, 0.08);
}


/* =========================================================
   FULLSCREEN
   ========================================================= */

.xplayer:fullscreen {
  position: relative;

  width: 100vw;
  height: 100vh;

  max-width: none;
  max-height: none;

  aspect-ratio: auto;

  border-radius: 0;

  background: #000;

  overflow: hidden;
}

.xplayer:fullscreen
.xplayer-video {
  width: 100vw;
  height: 100vh;

  min-width: 0;
  min-height: 0;

  object-fit: contain;
}


/* =========================================================
   WEBKIT FULLSCREEN
   ========================================================= */

.xplayer:-webkit-full-screen {
  position: relative;

  width: 100vw;
  height: 100vh;

  max-width: none;
  max-height: none;

  aspect-ratio: auto;

  border-radius: 0;

  background: #000;

  overflow: hidden;
}

.xplayer:-webkit-full-screen
.xplayer-video {
  width: 100vw;
  height: 100vh;

  object-fit: contain;
}


/* =========================================================
   FULLSCREEN CONTROLS
   ========================================================= */

.xplayer:fullscreen
.xplayer-controls {
  padding:
    35px 22px 15px;
}

.xplayer:-webkit-full-screen
.xplayer-controls {
  padding:
    35px 22px 15px;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 600px) {

  .xplayer {
    border-radius: 8px;

    /*
     * Don't use a hard-coded height.
     * React supplies the correct ratio.
     */
    width: 100%;
  }


  .xplayer-controls {
    padding:
      25px 9px 7px;
  }


  .xplayer-progress-area {
    height: 5px;

    margin-bottom: 6px;
  }


  .xplayer-progress-area:hover {
    height: 6px;
  }


  .xplayer-progress::after {
    width: 11px;
    height: 11px;

    right: -5px;
  }


  .xplayer-control-row {
    gap: 3px;
  }


  .xplayer-btn {
    width: 32px;
    height: 32px;
  }


  .xplayer-time {
    font-size: 11px;
  }


  .xplayer-volume-slider {
    width: 50px;
  }


  .xplayer-speed-btn {
    min-width: 38px;

    font-size: 12px;
  }


  .xplayer-center-play {
    width: 62px;
    height: 62px;
  }

}


/* =========================================================
   VERY SMALL MOBILE
   ========================================================= */

@media (max-width: 380px) {

  .xplayer-controls {
    padding:
      22px 6px 5px;
  }


  .xplayer-control-row {
    gap: 1px;
  }


  .xplayer-btn {
    width: 29px;
    height: 29px;
  }


  .xplayer-time {
    font-size: 10px;
  }


  .xplayer-volume-slider {
    width: 38px;
  }


  .xplayer-speed-btn {
    min-width: 34px;

    font-size: 11px;
  }


  .xplayer-center-play {
    width: 56px;
    height: 56px;
  }

}


/* =========================================================
   MOBILE LANDSCAPE
   ========================================================= */

@media (max-width: 900px)
and (orientation: landscape) {

  .xplayer:fullscreen {
    width: 100vw;

    height: 100vh;

    aspect-ratio: auto;

    border-radius: 0;
  }


  .xplayer:fullscreen
  .xplayer-video {
    width: 100vw;

    height: 100vh;

    object-fit: contain;
  }


  .xplayer:-webkit-full-screen {
    width: 100vw;

    height: 100vh;

    aspect-ratio: auto;

    border-radius: 0;
  }


  .xplayer:-webkit-full-screen
  .xplayer-video {
    width: 100vw;

    height: 100vh;

    object-fit: contain;
  }

}


/* =========================================================
   SHORT LANDSCAPE SCREEN
   ========================================================= */

@media (max-height: 500px)
and (orientation: landscape) {

  .xplayer-controls {
    padding:
      5px 10px 5px;
  }


  .xplayer-progress-area {
    height: 4px;

    margin-bottom: 4px;
  }


  .xplayer-progress-area:hover {
    height: 5px;
  }


  .xplayer-btn {
    width: 30px;
    height: 30px;
  }


  .xplayer-time {
    font-size: 11px;
  }


  .xplayer-volume-slider {
    width: 60px;
  }


  .xplayer-center-play {
    width: 55px;
    height: 55px;
  }


  .xplayer-speed-menu {
    bottom: 38px;

    max-height: 220px;
  }

}


/* =========================================================
   TOUCH DEVICES
   ========================================================= */

@media (hover: none)
and (pointer: coarse) {

  .xplayer-progress-area {
    height: 7px;
  }


  .xplayer-progress-area:hover {
    height: 7px;
  }


  .xplayer-progress::after {
    opacity: 1;

    width: 13px;
    height: 13px;
  }


  .xplayer-btn:hover {
    background: transparent;
  }

}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .xplayer *,
  .xplayer {
    animation-duration: 0.01ms !important;

    animation-iteration-count: 1 !important;

    transition-duration: 0.01ms !important;
  }

}

.xplayer-live-badge {
  position: absolute;
  top: 14px;
  left: 14px;
  z-index: 10;

  display: flex;
  align-items: center;
  gap: 6px;

  padding: 5px 9px;

  border-radius: 5px;

  background: #e50914;
  color: #fff;

  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.5px;
}

.xplayer-live-badge span {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #fff;

  animation: xplayer-live-pulse 1.2s
    infinite;
}

.xplayer-live-time {
  color: #ff3b30;
  font-weight: 700;
}

.xplayer-error {
  position: absolute;
  inset: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 20px;

  background: rgba(0, 0, 0, 0.7);

  color: #fff;

  text-align: center;
  font-size: 14px;
}

@keyframes xplayer-live-pulse {
  0% {
    opacity: 1;
  }

  50% {
    opacity: 0.35;
  }

  100% {
    opacity: 1;
  }
}


/* Orientation button is hidden by default */
.xplayer-orientation-btn {
  display: none;
}

/* Show orientation button only on mobile */
@media (max-width: 768px) {
  .xplayer.xplayer-fullscreen
    .xplayer-orientation-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
}
