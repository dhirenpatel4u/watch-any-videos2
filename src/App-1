import { Routes, Route } from "react-router-dom";
import Navbar from "./components/Navbar";
import Home from "./pages/Home";
import Watch from "./pages/Watch";

export default function App() {
  return (
    <>
      <Navbar />

      <Routes>
        <Route
          path="/"
          element={<Home />}
        />

        <Route
          path="/watch/:id"
          element={<Watch />}
        />

        <Route
          path="*"
          element={<Home />}
        />
      </Routes>
    </>
  );
}
